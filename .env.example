# ─── Anthropic / Claude ────────────────────────────────────────────
# Obtén tu clave en: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
TEMPERATURE=0.1

# Modelos: AUDIT_MODEL redacta (cláusulas, informe); AUDIT_MODEL_EXTRACT
# hace el trabajo de extracción, más barato.
AUDIT_MODEL=claude-sonnet-5
AUDIT_MODEL_EXTRACT=claude-haiku-4-5

# ─── LangSmith (opcional): tracing apagado salvo LANGSMITH_TRACING=true
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bartolo

# ─── Auth / multiusuario ───────────────────────────────────────────
# Esta herramienta tiene su propia tabla de usuarios: los usuarios que crees
# aquí NO existen en Tambora_chatbot, y al contrario.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_ENV_VAR
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8
COOKIE_SECURE=false

# ─── Base de datos ─────────────────────────────────────────────────
AUDIT_DB_PATH=data/auditorias.db
DAILY_QUERY_LIMIT=50
CONCURRENT_QUERY_LIMIT=2

# ─── Plantillas .docx ──────────────────────────────────────────────
# Material sensible: los .docx NO van en git (ver assets/plantillas/README.md).
# Por defecto se resuelven contra assets/plantillas/; deja estas variables
# vacías salvo que quieras apuntar a otra ubicación.
AUDIT_PLAN_TEMPLATE=
AUDIT_REPORT_TEMPLATE=

# ─── Capturas adjuntas a las cláusulas ─────────────────────────────
AUDIT_IMAGES_FOLDER=./data/audit_images

# ─── Panel de coste ────────────────────────────────────────────────
USD_EUR_RATE=0.92

# --- SSO contra Keycloak (2026-09-15) ------------------------------------
# La UNICA forma de entrar en Bartolo. El login propio se retiro, y con el
# las contrasenas compartidas.
#
# Sin las cuatro primeras la aplicacion NO ARRANCA, a proposito: al no haber
# login propio, una configuracion a medias dejaria la herramienta
# inaccesible sin decir por que.
BARTOLO_SSO_ISSUER=http://auth.sge.local:8080/realms/sge
BARTOLO_SSO_CLIENT_ID=bartolo
# Se obtiene de Keycloak (ver platform/identity/README.md). NUNCA se commitea.
BARTOLO_SSO_CLIENT_SECRET=
BARTOLO_SSO_REDIRECT_URI=http://bartolo.sge.local:8080/sso/callback
BARTOLO_SSO_POST_LOGOUT_URI=http://sge.local:8080/

# La vuelta al recibidor. Vacia = no se pinta el enlace.
BARTOLO_PLATAFORMA_URL=http://sge.local:8080/

# SGE_BASE_DOMAIN_ALT: el dominio ANTERIOR durante un cambio de dominio, para
# que la herramienta responda por los dos nombres a la vez. Se documenta
# entero en platform/.env.example. Aqui vale la misma regla que SGE_BASE_DOMAIN:
# el mismo valor en todos los .env, o cada pieza enruta por un sitio.
# SGE_BASE_DOMAIN_ALT=

# BARTOLO_RUTA_BASE: bajo que ruta se sirve la herramienta. Vacia (por defecto),
# emite sus enlaces desde la raiz y solo funciona el camino por nombre
# (bartolo.<dominio>); puesta a /bartolo, solo funciona el camino por ruta
# (<dominio>/bartolo). Va a la par con SGE_RUTAS de platform/.env. Lo explica el
# bloque de etiquetas de Traefik en docker-compose.yml.
# BARTOLO_RUTA_BASE=
